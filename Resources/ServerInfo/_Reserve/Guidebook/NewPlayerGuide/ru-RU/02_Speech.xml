# Стиль речи над головой

Реплики персонажей над их головами могут отображаться в компактном стиле Runechat или в виде классических облачков речи.

Выберите предпочтительный вариант. Его всегда можно изменить в меню «Настройки» (Esc).

<GuideChoiceRow CVar="chat.runechat">
  <GuideChoice Value="true" Title="Стиль Runechat" Description="Компактный цветной пиксельный текст над головой говорящего."/>
  <GuideChoice Value="false" Title="Облачка речи" Description="Классические всплывающие диалоговые пузыри над персонажем."/>
</GuideChoiceRow>

<GuideCVarSection CVar="chat.runechat" Equals="true">
  <GuideCard>
    <GuideCVarSlider CVar="chat.runechat_font_size" Title="Размер шрифта" Min="6" Max="24" Format="Int"/>
    <GuideCVarSlider CVar="chat.runechat_outline_scale" Title="Ширина обводки" Min="0" Max="2" Format="Percent"/>
  </GuideCard>
</GuideCVarSection>

<GuideCVarSection CVar="chat.runechat" Equals="false">
  <GuideCard>
    <GuideCVarCheckBox CVar="chat.enable_fancy_bubbles" Text="Отображать имена"/>
    <GuideCVarCheckBox CVar="chat.fancy_name_background" Text="Отображать фон имени" EnabledByCVar="chat.enable_fancy_bubbles"/>
  </GuideCard>
</GuideCVarSection>

<GuideCard Title="Так это выглядит:">
  <GuideSpeechPreview/>
</GuideCard>
</Document>
